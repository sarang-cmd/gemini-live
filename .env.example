# Copy to .env and fill in your key from https://aistudio.google.com/apikey
#
# The key stays on the server. The browser only ever receives short-lived
# ephemeral tokens that are good for a single Live session.
GEMINI_API_KEY=

# Port the Halo server listens on.
PORT=8787

# Bind address. 0.0.0.0 makes the app reachable from other devices.
HOST=0.0.0.0

# Set to true to lock minted ephemeral tokens to the requested model.
# Stricter, but the constraint check compares against the wire setup frame.
GEMINI_LOCK_TOKENS=false
