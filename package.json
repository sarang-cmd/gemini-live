{
  "name": "halo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Halo \u2014 a Siri-style voice assistant for the desktop, powered by the Gemini Live API and Groq",
  "main": "out/main/index.js",
  "author": "sarang-cmd",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "server": "node server/index.js",
    "test": "node --test --test-force-exit",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder",
    "electron:install": "node scripts/install-electron.mjs",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "npm run web:build && vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "dev.halo.assistant",
    "productName": "Halo",
    "copyright": "Copyright \u00a9 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "npmRebuild": false
  }
}
